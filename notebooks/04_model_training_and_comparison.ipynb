   "source": [
    "ACTION_COST_USD = 1_500      # assumption: cost of one intervention\n",
    "ACTION_SUCCESS_RATE = 0.70   # assumption: share of interventions that save the shipment\n",
    "\n",
    "value = work[\"Cargo_Value_USD\"].to_numpy()\n",
    "failed_mask = y.to_numpy() == 1\n",
    "per_thousand = 1000 / len(y)\n",
    "\n",
    "\n",
    "def alert_line(threshold, scores=chosen_proba):\n",
    "    flagged = scores >= threshold\n",
    "    caught = flagged & failed_mask\n",
    "    saved = (value[caught].sum() * ACTION_SUCCESS_RATE - flagged.sum() * ACTION_COST_USD) * per_thousand\n",
    "    return {\n",
    "        \"alert_line\": f\"{threshold:.0%}\",\n",
    "        \"alerts_per_1000\": flagged.sum() * per_thousand,\n",
    "        \"real_per_1000\": caught.sum() * per_thousand,\n",
    "        \"false_alarms_per_1000\": (flagged & ~failed_mask).sum() * per_thousand,\n",
    "        \"precision\": caught.sum() / max(flagged.sum(), 1),\n",
    "        \"recall\": caught.sum() / failed_mask.sum(),\n",
    "        \"net_saving_usd_per_1000\": saved,\n",
    "    }\n",
    "\n",
    "\n",
    "lines = pd.DataFrame([alert_line(t) for t in [0.10, 0.15, 0.20, 0.30, 0.40, 0.50, 0.60, 0.80]])\n",
    "lines.style.format({\n",
    "    \"alerts_per_1000\": \"{:.0f}\", \"real_per_1000\": \"{:.0f}\", \"false_alarms_per_1000\": \"{:.0f}\",\n",
    "    \"precision\": \"{:.0%}\", \"recall\": \"{:.0%}\", \"net_saving_usd_per_1000\": \"${:,.0f}\",\n",
    "}).hide(axis=\"index\")"
   ]
  },
